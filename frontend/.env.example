# Frontend environment variables (loaded by Vite; must be prefixed with VITE_).
# Dev uses vite proxy in vite.config.ts, so nothing here is required locally.
# Fill these in for production builds served without the dev proxy.

# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/api/ws
